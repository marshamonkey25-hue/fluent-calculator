FROM debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates cmake ninja-build g++ pkg-config dpkg-dev file binutils patchelf \
    dbus-daemon python3 python3-venv fonts-dejavu-core \
    libegl1 libgl1-mesa-dri libopengl0 libfontconfig1 libfreetype6 libglib2.0-0t64 \
    libdbus-1-3 libx11-6 libx11-xcb1 libxext6 libxrender1 libsm6 libice6 \
    libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-render0 libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 \
    libxcb-xfixes0 libxcb-randr0 libxcb-xkb1 libxkbcommon0 libxkbcommon-x11-0 \
    libwayland-client0 libwayland-cursor0 libwayland-egl1 libssl3t64 \
    && rm -rf /var/lib/apt/lists/*
# Debian's Qt 6.8 package omits FluentWinUI3. Use and deploy the official SDK,
# keeping its QML/theme/runtime private under /opt rather than replacing system Qt.
RUN python3 -m venv /opt/aqt \
    && /opt/aqt/bin/pip install --no-cache-dir aqtinstall==3.3.0 \
    && /opt/aqt/bin/aqt install-qt linux desktop 6.8.3 linux_gcc_64 \
        --outputdir /opt/Qt --archives qtbase qtdeclarative qtsvg qtshadertools qttranslations
ENV CMAKE_PREFIX_PATH=/opt/Qt/6.8.3/gcc_64
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    libgl-dev libegl-dev libopengl-dev libxkbcommon-dev \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/aqt/bin/aqt install-qt linux desktop 6.8.3 linux_gcc_64 \
        --outputdir /opt/Qt --archives icu qtwayland
WORKDIR /build
