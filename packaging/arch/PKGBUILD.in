# Generated from a matching source snapshot by prepare-source.py.
pkgname=fluent-calculator
pkgver=@VERSION@
pkgrel=1
pkgdesc='Windows 11 style Qt Quick calculator with scientific, programmer and conversion modes'
arch=('x86_64')
license=('LicenseRef-Project-Unspecified' 'MIT')
depends=('gcc-libs' 'glibc' 'qt6-base>=6.8' 'qt6-declarative>=6.8')
makedepends=('cmake' 'make' 'pkgconf' 'python')
checkdepends=('dbus')
options=('!debug' '!lto')
source=("$pkgname-$pkgver-source.tar.gz@SOURCE_URL_SUFFIX@")
sha256sums=('@SOURCE_SHA256@')

build() {
    cmake -S "$pkgname-$pkgver" -B build -G 'Unix Makefiles' \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_DOCDIR=share/doc/fluent-calculator \
        -DBUILD_TESTING=ON
    cmake --build build --parallel 2
}

check() {
    python "$srcdir/$pkgname-$pkgver/tests/run-ui-isolated.py" \
        ctest --test-dir build -R '^calculator-integrated-delivery-' \
        --output-on-failure --output-log "$srcdir/arch-tests.log" -j2
}

package() {
    # Require the Qt release used for this binary, not just the source minimum.
    depends=('gcc-libs' 'glibc'
        "qt6-base>=$(pkg-config --modversion Qt6Core)"
        "qt6-declarative>=$(pkg-config --modversion Qt6Qml)")
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/packaging/linux/LICENSE-STATUS.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/PROJECT-LICENSE-STATUS.txt"
}
